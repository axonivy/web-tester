pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '20'))
  }

  parameters {
    booleanParam(name: 'dryRun', defaultValue: true, description: 'Whether the build should publish the release.')
    string(name: 'version', defaultValue: '', description: 'Version to release.')
    string(name: 'engineSource', defaultValue: 'https://product.ivyteam.io', description: 'Engine page url.')
  }

  stages {
    stage('Validate preparations') {
      steps {
        script {
          if (!params.dryRun) {
            assertReleaseBranch()
          }
          assertReleaseVersionFormat()
          assertReleaseVersionMatchesProjectVersion()
          currentBuild.description = params.dryRun ? "Dry run (${params.version})" : params.version
        }
      }
    }

    stage('Build') {
      steps {
        script {
          docker.build('maven').inside {
            setVersion(params.version)
            withCredentials([string(credentialsId: 'gpg.password.axonivy', variable: 'GPG_PWD'), file(credentialsId: 'gpg.keystore.axonivy', variable: 'GPG_FILE')]) {
              sh "gpg --batch --import ${env.GPG_FILE}"
              def args = [
                '-Dmaven.test.skip=true',
                "-Dengine.page.url=${params.engineSource}",
                '-Divy.engine.version.latest.minor=true',
                '-Dskip.gpg=false',
                '-Dgpg.passphraseEnvName=GPG_PWD'
              ]
              if (params.dryRun) {
                args.add('-DaltDeploymentRepository=local::file:./target/deploy')
              }
              maven cmd: 'clean deploy ' + args.join(' ')
            }
          }
        }
        script {
          if (params.dryRun) {
            archiveArtifacts 'target/deploy/**/*'
          } else {
            archiveArtifacts '**/target/*.jar'
            archiveArtifacts '**/target/test-bom-*.pom'
          }
        }
      }
    }

    stage('Publish to GitHub') {
      when {
        expression { !params.dryRun }
      }
      steps {
        script {
          docker.build('maven').inside {
            def publishingUri = "https://nexus.axonivy.com/#browse/browse:maven-releases"
            currentBuild.description = "<a href='${publishingUri}'>${params.version}</a>"

            def targetBranch = "${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
            sh "git config --global user.name 'ivy-team'"
            sh "git config --global user.email 'info@ivyteam.ch'"
            sh "git checkout -b ${targetBranch}"
            sh "git tag -l | xargs git tag -d"
            sh "git add . ;git commit -m 'update versions for release ${params.version}'"
            sh "git tag \"v${params.version}\" -a -m \"Official release ${params.version}\""

            withEnv(['GIT_SSH_COMMAND=ssh -o StrictHostKeyChecking=no']) {
              sshagent(credentials: ['github-axonivy']) {
                def nextDevVersion = setNextSnapshotVersion(params.version)
                sh "git add . ;git commit -m 'prepare next dev-cycle ${nextDevVersion}'"
                sh "git push origin --tags"
                sh "git push -u origin ${targetBranch}"

                def title = "Prepare for next development cycle (${env.BRANCH_NAME})"
                def message = ":warning: merge this PR only if you verified the artifact is published on [Axon Ivy Nexus](${publishingUri}) and the release is published on GitHub ([Releases](https://github.com/axonivy/web-tester/releases))"
                withCredentials([file(credentialsId: 'github-ivyteam-token-repo-manager', variable: 'tokenFile')]) {
                  sh "gh auth login --with-token < ${tokenFile}"
                  sh "gh pr create --title '${title}' --body '${message}' --head ${targetBranch} --base ${env.BRANCH_NAME}"
                }
              }
            }
          }
        }
      }
    }
  }
}

def assertReleaseBranch() {
  if (!isReleasingBranch()) {
    error 'Releasing is only possible from a release branch.'
  }
}

def assertReleaseVersionFormat() {
  if (!(params.version ==~ /\d+\.\d+\.\d+/)) {
    error "Expected a valid release version, got '${params.version}'."
  }
}

def assertReleaseVersionMatchesProjectVersion() {
  def sourceVersion
  docker.build('maven').inside {
    sourceVersion = evaluateProjectVersion()
  }
  def expectedVersion = sourceVersion.replaceFirst(/-SNAPSHOT$/, '')
  if (params.version != expectedVersion) {
    error "Requested release ${params.version}, but pom.xml resolves to ${expectedVersion}."
  }
}

def evaluateProjectVersion() {
  sh(script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout", returnStdout: true).trim()
}

def setNextSnapshotVersion(def version) {
  def versionParts = version.tokenize('.')
  versionParts[2] = "${(versionParts[2] as int) + 1}-SNAPSHOT"
  def nextVersion = versionParts.join('.')
  sh ".ivy/manual-raise-version.sh ${nextVersion}"
  return nextVersion
}

def setVersion(def version) {
  maven cmd: "versions:set -DnewVersion=${version} -DprocessAllModules=true -DgenerateBackupPoms=false"
}
